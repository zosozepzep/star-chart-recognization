# 选用与你本地 WSL2 驱动兼容的 CUDA 运行时基础镜像
FROM nvidia/cuda:13.0.3-cudnn-runtime-ubuntu22.04

WORKDIR /workspace

# 避免 apt 安装时出现时区等交互提示
ENV DEBIAN_FRONTEND=noninteractive

# 安装 Python 和基础系统图形库 (GPU 版的 OpenCV 有时需要这些底层库支持)
RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-dev \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# 将系统 python3 链接为 python
RUN ln -s /usr/bin/python3 /usr/bin/python

# 先按 requirements.txt 钉住核心科学计算栈的版本，再装 torch / cupy 等重型轮子。
# 顺序很重要：若先装 torch/cupy 再回头安装 numpy==2.2.6，会把 numpy 换到已编译扩展
# 的脚下，触发 "numpy.dtype size changed" 这类硬 ImportError，而全局约束要求
# GPU 缺失时静默回退到 CPU，而不是抛异常。
RUN pip install --upgrade pip
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# 安装带 CUDA 支持相关的包
RUN pip install opencv-python numpy torch torchvision
RUN pip install astropy matplotlib
RUN pip install photutils scipy
RUN apt-get update && apt-get install -y source-extractor
RUN pip install pandas
RUN pip install cupy-cuda13x
RUN pip install --upgrade llvmlite numba

RUN apt-get update && apt-get install -y --no-install-recommends fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

CMD ["tail", "-f", "/dev/null"]