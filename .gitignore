# Ignore all files in data and output directories
data/**/*
output/**/*

# Except for .gitkeep files which preserve the directory structures
!data/**/.gitkeep
!output/**/.gitkeep

# Python cache
src/pycache/*
/src/__pycache__
.obsidian/

# Byte-compiled
__pycache__/
*.py[cod]

# 本地临时探针脚本
_probe/

# Local investigation, caches and generated source archives
/probe/
/.superpowers/
/.pytest_cache/
/.venv/
/dist/
/archive/
/suite.xml
/diagnostic_plot.png

